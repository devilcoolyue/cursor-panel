CURSOR_PANEL_DOMAIN=panel.example.com
# Both the application and maintenance service use this exact image.
CURSOR_PANEL_IMAGE=cursor-panel-v2:local
CURSOR_PANEL_VERSION=0.0.9
CURSOR_PANEL_REVISION=unrecorded
# The update service switches to a new data volume after a successful migration.
CURSOR_PANEL_DATA_VOLUME=cursor-panel-v2_data
# Choose an unused Docker subnet; the proxy IP must belong to it.
CURSOR_PANEL_SUBNET=172.30.87.0/24
# Dynamic allocation must exclude the fixed proxy IP.
CURSOR_PANEL_DYNAMIC_RANGE=172.30.87.128/25
CURSOR_PANEL_PROXY_IP=172.30.87.2
CURSOR_AUDIT_RETENTION_DAYS=90
CURSOR_AUDIT_MAX_EVENTS=100000
